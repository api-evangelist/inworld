            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.inworld.ai/v1/voices/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get voice"
        },
        {
          "info": {
            "name": "Update voice",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.inworld.ai/v1/voices/:id",

                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete voice"
        },
        {
          "info": {
            "name": "Clone voice from audio",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.inworld.ai/v1/voices/clone",
